# Picks which API the app talks to. Unset = development (local backend).
#   development → http://localhost:4000/api/v1   (auto-resolved to the LAN host)
#   staging | production → https://talent-pro-backend.dev-api.softweirdo.com/api/v1
APP_ENV=development

# Overrides the URL entirely, for a one-off (a colleague's machine, a tunnel).
# API_URL=http://192.168.1.50:4000/api/v1
